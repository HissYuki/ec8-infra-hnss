<group name="hospital,">
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="source">^hospital.security$</field>
    <description>Hospital: evento de auditoria sanitizado.</description>
  </rule>
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^password_login_failed$|^mfa_failed$</field>
    <description>Hospital: falha de autenticacao.</description>
    <group>authentication_failed,</group>
  </rule>
  <rule id="100102" level="8" frequency="5" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <description>Hospital: repetidas falhas de autenticacao no agente; verificar contexto.</description>
    <group>authentication_failures,</group>
  </rule>
  <rule id="100110" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^monitoring_test$</field>
    <description>Hospital: validacao benigna de coleta SIEM.</description>
  </rule>
</group>

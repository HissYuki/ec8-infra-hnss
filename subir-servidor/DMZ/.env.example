# Exclusivo da máquina DMZ. Use valores literais; não execute este arquivo como shell.
# Não são necessárias senhas de bancos, SMTP, Vault ou Keycloak nesta máquina.
PUBLIC_HOST=SUBSTITUA_PELO_DOMINIO_PUBLICO
PUBLIC_ORIGIN=https://SUBSTITUA_PELO_DOMINIO_PUBLICO
DMZ_BIND_IP=SUBSTITUA_PELO_IP_INTERFACE_VLAN10
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
PUBLIC_HTTPS_SUFFIX=
BACKEND_URL=https://SUBSTITUA_PELO_FQDN_OU_IP_BACKEND:8444
BACKEND_TLS_NAME=SUBSTITUA_PELO_SAN_CERTIFICADO_BACKEND
TLS_DIR=/etc/hospital/dmz/tls
DMZ_DOCKER_SUBNET=172.28.10.0/24
FRONTEND_EGRESS_SUBNET=172.28.11.0/24
NODE_EXPORTER_BIND_IP=SUBSTITUA_IP_INTERFACE_VLAN10
DMZ_NODE_EXPORTER_PORT=9100

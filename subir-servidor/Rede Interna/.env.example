# Exclusivo da máquina Rede Interna. Credenciais são placeholders, nunca senhas reais.
PUBLIC_HOST=SUBSTITUA_PELO_DOMINIO_PUBLICO
PUBLIC_ORIGIN=https://SUBSTITUA_PELO_DOMINIO_PUBLICO
DJANGO_SECRET_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_APP
INFRA_POSTGRES_USER=app_admin
INFRA_POSTGRES_DB=dados_db
INFRA_POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_ADMIN_BANCO
KEYCLOAK_DB_USER=keycloak_admin
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_PASSWORD=SUBSTITUA_POR_SENHA_BANCO_KEYCLOAK
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_ADMIN_KEYCLOAK
# Bind administrativo compartilhado por Vault/Keycloak na configuração existente.
# Loopback exige acesso local ou túnel; para gestão remota use a interface restrita.
SECURITY_BIND_IP=127.0.0.1
KMS_BIND_IP=127.0.0.1
KMS_PORT=8201
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB
VAULT_CONFIG_FILE=/etc/hospital/interna/vault.hcl
# Somente após habilitar Transit no KMS e preparar token com política restrita.
VAULT_TRANSIT_SEAL_TOKEN=
KEYCLOAK_PORT=8180
BACKEND_BIND_IP=SUBSTITUA_PELO_IP_INTERFACE_VLAN20
TLS_DIR=/etc/hospital/interna/tls
GUNICORN_WORKERS=2
DJANGO_HSTS_SECONDS=0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=SUBSTITUA_PELO_SERVIDOR_SMTP
EMAIL_PORT=587
EMAIL_HOST_USER=SUBSTITUA_PELO_USUARIO_SMTP
EMAIL_HOST_PASSWORD=SUBSTITUA_POR_SENHA_SMTP
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=SUBSTITUA_PELO_EMAIL_REMETENTE
PASSWORD_RESET_TIMEOUT=600
MFA_LOGIN_TIMEOUT=600
OTP_TOTP_ISSUER=Hospital Nossa Senhora da Saúde
WAZUH_RUNTIME_DIR=/etc/hospital/interna/wazuh-runtime
WAZUH_BIND_IP=SUBSTITUA_PELO_IP_INTERFACE_VLAN30
WAZUH_DASHBOARD_BIND_IP=127.0.0.1
WAZUH_DASHBOARD_PORT=9443
WAZUH_INDEXER_ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_INDEXER
WAZUH_DASHBOARD_PASSWORD=SUBSTITUA_POR_SENHA_SERVICO_DASHBOARD
WAZUH_API_PASSWORD=SUBSTITUA_POR_SENHA_API
WAZUH_ENROLLMENT_PASSWORD=SUBSTITUA_POR_SENHA_CADASTRO_AGENTES
INTERNAL_DOCKER_SUBNET=172.28.20.0/24
SECURITY_DOCKER_SUBNET=172.28.30.0/24
ENDPOINT_DOCKER_SUBNET=172.28.40.0/24
PROMETHEUS_TARGET_VLAN10=SUBSTITUA_IP_DMZ:9100
PROMETHEUS_TARGET_VLAN20=SUBSTITUA_IP_DADOS:9100
PROMETHEUS_TARGET_VLAN40=SUBSTITUA_IP_ESTACAO:9100
NODE_EXPORTER_BIND_IP=SUBSTITUA_IP_INTERFACE_VLAN20
NODE_EXPORTER_PORT=9100

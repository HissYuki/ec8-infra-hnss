# Local: o script subir-local/local.ps1 gera uma cópia ignorada, com valores aleatórios.
# Servidores: copie SOMENTE as variáveis necessárias para cada máquina.
DJANGO_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
INFRA_POSTGRES_USER=app_admin
INFRA_POSTGRES_DB=dados_db
INFRA_POSTGRES_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_ALEATORIA
KEYCLOAK_DB_USER=keycloak_admin
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_ALEATORIA
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_ALEATORIA
SECURITY_BIND_IP=127.0.0.1
KMS_BIND_IP=127.0.0.1
KMS_PORT=8201
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB
# Local: vault.local.hcl. Servidor: configuração privada real.
VAULT_CONFIG_FILE=SUBSTITUA_PELO_CAMINHO_ABSOLUTO_VAULT_HCL
VAULT_TRANSIT_SEAL_TOKEN=
KEYCLOAK_PORT=8180

# Local: localhost; servidores: nome público e interfaces físicas correspondentes.
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=https://localhost:8443
DMZ_BIND_IP=127.0.0.1
PUBLIC_HTTP_PORT=18080
PUBLIC_HTTPS_PORT=8443
PUBLIC_HTTPS_SUFFIX=:8443
BACKEND_URL=https://hospital-backend:8444
BACKEND_TLS_NAME=hospital-backend
BACKEND_BIND_IP=SUBSTITUA_PELO_IP_VLAN20
# Caminho absoluto local para os certificados, separado em cada servidor.
TLS_DIR=SUBSTITUA_PELO_CAMINHO_ABSOLUTO
GUNICORN_WORKERS=2
DJANGO_HSTS_SECONDS=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hospital@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
PASSWORD_RESET_TIMEOUT=600
MFA_LOGIN_TIMEOUT=600
OTP_TOTP_ISSUER=Hospital Nossa Senhora da Saúde

# Wazuh: material privado preparado por subir-local/local.ps1 para testes locais.
# Targets do laboratório. Nos servidores use IP/FQDN:porta; múltiplos hosts separados por vírgula.
PROMETHEUS_TARGET_VLAN10=node-exporter-dmz:9100
PROMETHEUS_TARGET_VLAN20=node-exporter-dados:9100
PROMETHEUS_TARGET_VLAN40=node-exporter-endpoints:9100
NODE_EXPORTER_BIND_IP=127.0.0.1
NODE_EXPORTER_PORT=9100
DMZ_NODE_EXPORTER_PORT=19110
WAZUH_RUNTIME_DIR=SUBSTITUA_PELO_CAMINHO_ABSOLUTO
WAZUH_BIND_IP=127.0.0.1
WAZUH_DASHBOARD_BIND_IP=127.0.0.1
WAZUH_DASHBOARD_PORT=9443
WAZUH_INDEXER_ADMIN_PASSWORD=SUBSTITUA
WAZUH_DASHBOARD_PASSWORD=SUBSTITUA
WAZUH_API_PASSWORD=SUBSTITUA
WAZUH_ENROLLMENT_PASSWORD=SUBSTITUA

# Copie para .env e substitua os dois valores abaixo antes de iniciar.
# Não coloque credenciais reais neste arquivo versionado.
DJANGO_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
POSTGRES_HOST=db
POSTGRES_PORT=5432

# E-mails locais aparecem em docker compose logs web.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hospital@localhost
# Para SMTP: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
PASSWORD_RESET_TIMEOUT=600
MFA_LOGIN_TIMEOUT=600
OTP_TOTP_ISSUER=Hospital Nossa Senhora da Saúde
